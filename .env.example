# Copy to .env.local for local testing, and add the same keys in Vercel > Project > Settings > Environment Variables.
# Leave CLOVER_PRIVATE_TOKEN or CLOVER_MERCHANT_ID empty to run checkout in demo mode (never allowed on the live site).
CLOVER_ENV=sandbox                 # sandbox or production
CLOVER_MERCHANT_ID=
CLOVER_PRIVATE_TOKEN=
CLOVER_WEBHOOK_SECRET=             # from the Hosted Checkout webhook setup
CLOVER_INVENTORY_TOKEN=            # token with Inventory read + write; when set, the shop lists your Clover items
CLOVER_PAGE_CONFIG_UUID=           # optional: a custom Hosted Checkout page design

# Order and contact form emails, sent with Resend (resend.com). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
NOTIFY_EMAIL=                      # where emails go; separate several with commas
EMAIL_FROM=                        # e.g. Found Again <orders@found-again.co>

# Login for /admin, where items are added to the shop. Leave either empty to switch /admin off.
ADMIN_USERNAME=
ADMIN_PASSWORD=                    # long and random, e.g. from `openssl rand -base64 18`

# Set automatically when you connect Vercel Blob in Vercel > Storage (stores product photos). Not needed locally.
# BLOB_READ_WRITE_TOKEN=

# Set automatically when you connect Upstash Redis in Vercel > Storage. Not needed locally (dev uses memory).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
